{
  "threshold": 3,
  "minLines": 10,
  "minTokens": 70,
  "reporters": ["console"],
  "output": "",
  "ignore": [
    "node_modules",
    "dist",
    "build",
    ".venv",
    "__pycache__",
    "*.egg-info",
    ".tox",
    ".git",
    "*.lock",
    "*.min.js",
    "*.min.css",
    "bun.lock",
    "uv.lock",
    "package-lock.json",
    "template",
    ".agents",
    ".claude",
    ".github",
    ".azuredevops",
    ".gsd",
    "docs",
    "openspec",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "**/*.ps1",
    "**/*.sh",
    "**/*.zsh",
    "htmlcov",
    "coverage",
    ".pre-commit-cache",
    "logs/**"
