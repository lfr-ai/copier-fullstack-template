{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4",
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "env": {
    "PYTHONPATH": "scripts:template/backend/src",
    "UV_LINK_MODE": "copy",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "FORCE_COLOR": "1"
  },
  "attribution": {
    "commit": "chore(claude): {{summary}}",
    "pr": "🤖 Claude Code: {{summary}}"
  },
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch(https://github.com/**)",
      "WebFetch(https://*.github.com/**)",
      "WebFetch(https://api.github.com/**)",
      "WebFetch(https://registry.npmjs.org/**)",
      "WebFetch(https://*.npmjs.org/**)",
      "WebFetch(https://pypi.org/**)",
      "WebFetch(https://files.pythonhosted.org/**)",
      "WebFetch(https://context7.com/**)",
      "WebFetch(https://mcp.context7.com/**)",
      "Bash(uvx *)",
      "Bash(uv *)",
      "Bash(task *)",
      "Bash(python *)",
      "Bash(pre-commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(shellcheck *)",
      "Bash(actionlint *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(tree *)",
      "Bash(diff *)",
      "mcp__context7__*",
      "mcp__gitnexus__*",
      "mcp__shadcn__*"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git push*)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.local)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf $HOME)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fx*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear)",
      "Bash(git branch -D *)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Bash(*--no-verify*)",
      "Bash(pip install *)",
      "Bash(npm install -g *)",
      "Bash(apt-get *)",
      "Bash(yum *)",
      "Bash(brew install *)",
      "Bash(choco install *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "WebFetch(**)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "filesystem": {
      "denyWrite": [
        "~/.ssh/**",
        "~/.aws/**",
        "~/.config/**",
        "/etc/**"
      ]
    }
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\scripts\\guard-destructive.ps1\"",
            "timeout": 10,
            "statusMessage": "Tool Guardian: checking for dangerous operations..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(echo \"$TOOL_INPUT\" | python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); if [[ \"$f\" == *.py ]] && [ -f \"$f\" ]; then uvx ruff check --fix \"$f\" 2>/dev/null; fi; exit 0",
            "timeout": 15,
            "statusMessage": "Linting Python file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\scripts\\check-licenses.ps1\"",
            "timeout": 60,
            "statusMessage": "License Checker: scanning dependency licenses..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".venv",
      "__pycache__",
      ".pytest_cache",
      ".ruff_cache",
      ".mypy_cache",
      ".cache",
      ".pre-commit-cache",
      "dist",
      "build",
      "*.egg-info"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "repo-quality-gate@claude-plugins-official": true,
    "react-testing-library@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "awaySummaryEnabled": true,
  "autoMemoryEnabled": true,
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "showMessageTimestamps": true,
  "todoFeatureEnabled": true,
  "outputStyle": "Concise",
  "language": "english"
}
