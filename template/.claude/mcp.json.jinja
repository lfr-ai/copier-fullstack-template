{
  "$schema": "https://schemas.anthropic.com/mcp/servers.json",
  "mcpServers": {
{% if use_playwright %}
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--isolated", "--headless"],
      "description": "Playwright MCP server for structured browser automation"
    },
{% endif %}
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "description": "Context7 MCP server for library documentation lookup"
    },
    "shadcn": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"],
      "description": "shadcn MCP server for component registry search and install"
    }{% if with_gitnexus %},
    "gitnexus": {
      "type": "stdio",
      "command": "gitnexus",
      "args": ["mcp"],
      "cwd": "${workspaceFolder}",
      "description": "GitNexus MCP server for graph-powered code intelligence"
    }{% endif %}
  }
}
