{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "env": {
    "PYTHONPATH": "backend/src",
    "UV_LINK_MODE": "copy",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "includeGitInstructions": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(task *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run ty*)",
      "Bash(bun run*)",
      "Bash(bun test*)",
      "Bash(bunx biome*)",
      "Bash(bunx shadcn*)",
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "mcp__context7__*",
      "mcp__shadcn__*"{% if with_gitnexus %},
      "mcp__gitnexus__*"{% endif %}
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.local)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fx*)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(*--no-verify*)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(pip install *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/hooks/guard-destructive.sh ]; then bash .claude/hooks/guard-destructive.sh; fi",
            "timeout": 10,
            "statusMessage": "Checking for destructive commands..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(echo \"$TOOL_INPUT\" | python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); if [[ \"$f\" == *.py ]] && [ -f \"$f\" ]; then uv run ruff check --fix \"$f\" 2>/dev/null; fi; exit 0",
            "timeout": 15,
            "statusMessage": "Linting Python file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/hooks/stop-uncommitted-reminder.sh ]; then bash .claude/hooks/stop-uncommitted-reminder.sh; fi",
            "timeout": 10,
            "statusMessage": "Checking working tree..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".venv",
      "__pycache__",
      ".cache"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "repo-quality-gate@claude-plugins-official": true,
    "react-testing-library@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "awaySummaryEnabled": true,
  "autoMemoryEnabled": true,
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "showMessageTimestamps": true,
  "todoFeatureEnabled": true
}
