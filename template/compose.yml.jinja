x-common-env: &common-env
  {{ project_slug | upper }}_ENVIRONMENT: local
{%- if database_backend == "postgresql" %}
  {{ project_slug | upper }}_DATABASE_URL: ${{ '{' }}{{ project_slug | upper }}_DATABASE_URL:-sqlite+aiosqlite:///./data/{{ project_slug }}.db{{ '}' }}
{%- elif database_backend == "azure_postgresql" %}
  {{ project_slug | upper }}_DATABASE_URL: ${{ '{' }}{{ project_slug | upper }}_DATABASE_URL:-sqlite+aiosqlite:///./data/{{ project_slug }}.db{{ '}' }}
{%- elif database_backend == "sqlite" %}
  {{ project_slug | upper }}_DATABASE_URL: sqlite+aiosqlite:///./data/{{ project_slug }}.db
{%- endif %}
  {{ project_slug | upper }}_SECRET_KEY: ${{ '{' }}{{ project_slug | upper }}_SECRET_KEY:-change-me-in-production{{ '}' }}
{%- if use_redis %}
  {{ project_slug | upper }}_REDIS_URL: redis://redis:6379/0
{%- endif %}
{%- if use_ai %}
  {{ project_slug | upper }}_OPENAI_API_KEY: ${{ '{' }}{{ project_slug | upper }}_OPENAI_API_KEY:-{{ '}' }}
  {{ project_slug | upper }}_OPENAI_MODEL: ${{ '{' }}{{ project_slug | upper }}_OPENAI_MODEL:-gpt-4o{{ '}' }}
  {{ project_slug | upper }}_EMBEDDING_MODEL: ${{ '{' }}{{ project_slug | upper }}_EMBEDDING_MODEL:-text-embedding-3-small{{ '}' }}
  {{ project_slug | upper }}_EMBEDDING_DIMENSION: ${{ '{' }}{{ project_slug | upper }}_EMBEDDING_DIMENSION:-1536{{ '}' }}
{%- endif %}
{%- if use_anthropic %}
  {{ project_slug | upper }}_ANTHROPIC_API_KEY: ${{ '{' }}{{ project_slug | upper }}_ANTHROPIC_API_KEY:-{{ '}' }}
  {{ project_slug | upper }}_ANTHROPIC_MODEL: ${{ '{' }}{{ project_slug | upper }}_ANTHROPIC_MODEL:-claude-sonnet-4-6{{ '}' }}
{%- endif %}
{%- if use_azure_openai %}
  {{ project_slug | upper }}_AZURE_OPENAI_ENDPOINT: ${{ '{' }}{{ project_slug | upper }}_AZURE_OPENAI_ENDPOINT:-{{ '}' }}
  {{ project_slug | upper }}_AZURE_OPENAI_API_KEY: ${{ '{' }}{{ project_slug | upper }}_AZURE_OPENAI_API_KEY:-{{ '}' }}
  {{ project_slug | upper }}_AZURE_OPENAI_DEPLOYMENT: ${{ '{' }}{{ project_slug | upper }}_AZURE_OPENAI_DEPLOYMENT:-{{ '}' }}
{%- endif %}
{%- if use_faiss %}
  {{ project_slug | upper }}_FAISS_PERSIST_DIR: /app/data/faiss
{%- endif %}
{%- if use_mcp %}
  {{ project_slug | upper }}_MCP_ENABLED: ${{ '{' }}{{ project_slug | upper }}_MCP_ENABLED:-false{{ '}' }}
{%- endif %}
{%- if use_lightrag %}
  {{ project_slug | upper }}_LIGHTRAG_WORKING_DIR: /app/data/lightrag
  {{ project_slug | upper }}_LIGHTRAG_GRAPH_STORAGE: ${{ '{' }}{{ project_slug | upper }}_LIGHTRAG_GRAPH_STORAGE:-NetworkXStorage{{ '}' }}
  {{ project_slug | upper }}_LIGHTRAG_VECTOR_STORAGE: ${{ '{' }}{{ project_slug | upper }}_LIGHTRAG_VECTOR_STORAGE:-NanoVectorDBStorage{{ '}' }}
  {{ project_slug | upper }}_LIGHTRAG_LLM_MODEL: ${{ '{' }}{{ project_slug | upper }}_LIGHTRAG_LLM_MODEL:-gpt-4o-mini{{ '}' }}
{%- endif %}

name: {{ project_slug }}

services:
  app:
    build:
      context: .
      dockerfile: Containerfile
      target: dev
    init: true
    env_file:
      - path: .env
        required: false
      - path: .env.local
        required: false
    environment:
      <<: *common-env
    volumes:
      - ./logs:/app/logs
{%- if database_backend in ("postgresql", "azure_postgresql", "sqlite") %}
      - sqlite-data:/app/data
{%- endif %}
{%- if use_faiss %}
      - faiss-data:/app/data/faiss
{%- endif %}
{%- if use_lightrag %}
      - lightrag-data:/app/data/lightrag
{%- endif %}
{%- if use_redis %}
    depends_on:
      redis:
        condition: service_healthy
{%- endif %}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - backend
{%- if use_caddy %}
      - frontend
{%- endif %}

  frontend:
    build:
      context: frontend
      dockerfile: Containerfile
      target: dev
    init: true
    healthcheck:
      test: ["CMD-SHELL", "wget --spider --quiet http://localhost:3000 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - frontend

{%- if use_caddy %}
  caddy:
    image: caddy:2.9-alpine
    init: true
    cap_add:
      - NET_BIND_SERVICE
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    environment:
      CADDY_DOMAIN: ${CADDY_DOMAIN:-localhost}
      CADDY_LOG_LEVEL: ${CADDY_LOG_LEVEL:-INFO}
      BACKEND_PORT: "8000"
      FRONTEND_PORT: "3000"
    depends_on:
      app:
        condition: service_healthy
      frontend:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:80/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - frontend
      - backend
    profiles:
      - gateway
{%- endif %}
{%- if use_redis %}

  redis:
    image: redis:7-alpine
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    networks:
      - backend
{%- endif %}
{%- if database_backend == "postgresql" %}

  db:
{%- if use_pgvector %}
    image: pgvector/pgvector:pg17
{%- else %}
    image: postgres:17-alpine
{%- endif %}
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
      POSTGRES_DB: {{ project_slug }}
      POSTGRES_INITDB_ARGS: "--auth-host=scram-sha-256"
    shm_size: 256m
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d {{ project_slug }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks:
      - backend
    profiles:
      - postgres
{%- endif %}
{%- if use_celery %}

  worker:
    build:
      context: .
      dockerfile: Containerfile
      target: dev
    init: true
    env_file:
      - path: .env
        required: false
      - path: .env.local
        required: false
    environment:
      <<: *common-env
    command: ["celery", "-A", "{{ project_slug }}.config.celery:celery_app", "worker", "--loglevel=info"]
{%- if database_backend in ("postgresql", "azure_postgresql", "sqlite") %}
    volumes:
      - sqlite-data:/app/data
{%- endif %}
{%- if use_redis %}
    depends_on:
      redis:
        condition: service_healthy
{%- endif %}
    healthcheck:
      test: ["CMD", "celery", "-A", "{{ project_slug }}.config.celery:celery_app", "inspect", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    networks:
      - backend

  beat:
    build:
      context: .
      dockerfile: Containerfile
      target: dev
    init: true
    env_file:
      - path: .env
        required: false
      - path: .env.local
        required: false
    environment:
      <<: *common-env
    command: ["celery", "-A", "{{ project_slug }}.config.celery:celery_app", "beat", "--loglevel=info", "--pidfile=/tmp/celerybeat.pid"]
{%- if use_redis %}
    depends_on:
      redis:
        condition: service_healthy
{%- endif %}
    healthcheck:
      test: ["CMD-SHELL", "test -f /tmp/celerybeat.pid && kill -0 $(cat /tmp/celerybeat.pid)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    networks:
      - backend
{%- endif %}
{%- if use_knowledge_graph and knowledge_graph_backend == "neo4j" %}

  neo4j:
    image: neo4j:5-community
    environment:
      NEO4J_AUTH: ${NEO4J_AUTH:-neo4j/changeme}  # Override in production
    volumes:
      - neo4j-data:/data
    healthcheck:
      test: ["CMD-SHELL", "wget --spider --quiet http://localhost:7474 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
    networks:
      - backend
    profiles:
      - knowledge-graph
{%- endif %}
{%- if use_mcp %}

  mcp-server:
    build:
      context: .
      dockerfile: Containerfile
      target: dev
    init: true
    env_file:
      - path: .env
        required: false
      - path: .env.local
        required: false
    environment:
      <<: *common-env
      {{ project_slug | upper }}_MCP_ENABLED: "true"
    command: ["python", "-m", "{{ project_slug }}.ai.mcp.server"]
{%- if database_backend in ("postgresql", "azure_postgresql", "sqlite") %}
    volumes:
      - sqlite-data:/app/data
{%- endif %}
{%- if use_redis %}
    depends_on:
      redis:
        condition: service_healthy
{%- endif %}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8001/health', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - backend
    profiles:
      - mcp
{%- endif %}

  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    volumes:
      - ./infra/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
    ports:
      - "9090:9090"
    networks:
      - backend
    healthcheck:
      test: ["CMD", "wget", "--spider", "--quiet", "http://localhost:9090/-/healthy"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    profiles:
      - monitoring

  otel-collector:
    image: otel/opentelemetry-collector-contrib:latest
    container_name: otel-collector
    command: ["--config=/etc/otel-collector.yaml"]
    volumes:
      - ./infra/otel/collector.yaml:/etc/otel-collector.yaml:ro
    ports:
      - "4317:4317"   # OTLP gRPC
      - "4318:4318"   # OTLP HTTP
      - "8889:8889"   # Prometheus metrics
    depends_on:
      app:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--spider", "--quiet", "http://localhost:8889/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - backend
    profiles:
      - monitoring

  tempo:
    image: grafana/tempo:latest
    container_name: tempo
    command: ["-config.file=/etc/tempo.yaml"]
    volumes:
      - ./infra/tempo/tempo.yaml:/etc/tempo.yaml:ro
      - tempo-data:/var/tempo
    ports:
      - "3200:3200"
      - "4319:4317"
      - "4320:4318"
    healthcheck:
      test: ["CMD", "wget", "--spider", "--quiet", "http://localhost:3200/ready"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - backend
    profiles:
      - monitoring

  grafana:
    image: grafana/grafana-oss:latest
    container_name: grafana
    ports:
      - "3001:3000"
    volumes:
      - ./infra/grafana/provisioning:/etc/grafana/provisioning
      - grafana-data:/var/lib/grafana
    environment:
      GF_SECURITY_ADMIN_PASSWORD: "admin"
    depends_on:
      prometheus:
        condition: service_healthy
      tempo:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--spider", "--quiet", "http://localhost:3000/login"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - backend
    profiles:
      - monitoring

{%- if use_matomo %}

  matomo-db:
    image: mariadb:11
    container_name: matomo-db
    command: ["--max-allowed-packet=64MB", "--innodb-buffer-pool-size=256M"]
    environment:
      MARIADB_ROOT_PASSWORD: ${MATOMO_DB_ROOT_PASSWORD:-change-me}
      MARIADB_DATABASE: ${MATOMO_DB_NAME:-matomo}
      MARIADB_USER: ${MATOMO_DB_USER:-matomo}
      MARIADB_PASSWORD: ${MATOMO_DB_PASSWORD:-change-me}
    volumes:
      - matomo-db-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 20s
      timeout: 5s
      retries: 5
      start_period: 20s
    networks:
      - backend
    profiles:
      - analytics

  matomo:
    image: matomo:latest
    container_name: matomo
    ports:
      - "8082:80"
    environment:
      MATOMO_DATABASE_HOST: matomo-db
      MATOMO_DATABASE_ADAPTER: mysql
      MATOMO_DATABASE_TABLES_PREFIX: matomo_
      MATOMO_DATABASE_USERNAME: ${MATOMO_DB_USER:-matomo}
      MATOMO_DATABASE_PASSWORD: ${MATOMO_DB_PASSWORD:-change-me}
      MATOMO_DATABASE_DBNAME: ${MATOMO_DB_NAME:-matomo}
    volumes:
      - matomo-data:/var/www/html
    depends_on:
      matomo-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--spider", "--quiet", "http://localhost/index.php"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s
    networks:
      - backend
    profiles:
      - analytics
{%- endif %}

volumes:
{%- if use_redis %}
  redis-data:
{%- endif %}
{%- if database_backend == "postgresql" %}
  postgres-data:
  sqlite-data:
{%- elif database_backend in ("azure_postgresql", "sqlite") %}
  sqlite-data:
{%- endif %}
{%- if use_caddy %}
  caddy_data:
  caddy_config:
{%- endif %}
{%- if use_faiss %}
  faiss-data:
{%- endif %}
{%- if use_knowledge_graph and knowledge_graph_backend == "neo4j" %}
  neo4j-data:
{%- endif %}
{%- if use_lightrag %}
  lightrag-data:
{%- endif %}
  prometheus-data:
  grafana-data:
  tempo-data:
{%- if use_matomo %}
  matomo-data:
  matomo-db-data:
{%- endif %}

networks:
  backend:
    driver: bridge
  frontend:
    driver: bridge
