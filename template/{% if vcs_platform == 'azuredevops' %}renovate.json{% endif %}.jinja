{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platform": "azure",
  "endpoint": "{% raw %}{{ RENOVATE_ENDPOINT }}{% endraw %}",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "timezone": "Europe/Copenhagen",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group Python framework updates together",
      "groupName": "python-frameworks",
      "matchManagers": ["pip_requirements", "pip_setup", "pipenv", "poetry"],
      "matchPackageNames": [
        "fastapi",
        "pydantic",
        "pydantic-core",
        "pydantic-settings",
        "sqlalchemy",
        "alembic"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "backend"
    },
    {
      "description": "Group Python minor/patch updates",
      "groupName": "python-minor-patch",
      "matchManagers": ["pip_requirements", "pip_setup", "pipenv", "poetry"],
      "matchPackageNames": [
        "*",
        "!fastapi",
        "!pydantic",
        "!pydantic-core",
        "!pydantic-settings",
        "!sqlalchemy",
        "!alembic"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "backend"
    },
    {
      "description": "Group React ecosystem updates together",
      "groupName": "react-ecosystem",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "/^@types\\/react/",
        "/^react-router/"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "frontend"
    },
    {
      "description": "Group UI component library updates",
      "groupName": "ui-components",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "/^@radix-ui\\//",
        "tailwindcss",
        "class-variance-authority",
        "clsx",
        "tailwind-merge"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "frontend"
    },
    {
      "description": "Group dev tooling updates together",
      "groupName": "dev-tooling",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "ruff",
        "pytest",
        "pytest-cov",
        "pytest-asyncio",
        "mypy",
        "vitest",
        "vite",
        "@vitejs/plugin-react",
        "typescript",
        "eslint",
        "prettier"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "dev"
    },
    {
      "description": "Pin Azure Pipelines tasks to major versions only",
      "matchManagers": ["azure-pipelines"],
      "extractVersion": "^(?<version>\\d+)",
      "versioning": "semver",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Auto-merge Python patch updates",
      "matchManagers": ["pip_requirements", "pip_setup", "pipenv", "poetry"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "semanticCommitType": "chore",
      "semanticCommitScope": "security"
    },
    {
      "description": "Auto-merge npm patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "semanticCommitType": "chore",
      "semanticCommitScope": "security"
    }{% if container_runtime == 'docker' %},
    {
      "description": "Group Docker base image updates",
      "groupName": "docker-images",
      "matchDatasources": ["docker"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "docker"
    }
{% endif %}
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "enabledManagers": [
    "pip_requirements",
    "pip_setup",
    "npm",
    "dockerfile",
    "docker-compose",
    "azure-pipelines"
  ]
}
