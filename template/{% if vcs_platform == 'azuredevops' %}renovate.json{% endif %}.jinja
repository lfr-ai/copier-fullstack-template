{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platform": "azure",
  "endpoint": "{% raw %}{{ RENOVATE_ENDPOINT }}{% endraw %}",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":rebaseStalePrs"
  ],
  "description": [
    "Renovate config tuned for this template's frontend-first fullstack stack."
  ],
  "configMigration": true,
  "fetchChangeLogs": "off",
  "prCreation": "not-pending",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "timezone": "Europe/Copenhagen",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Auto-merge npm minor/patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "semanticCommitType": "chore",
      "semanticCommitScope": "frontend"
    },
    {
      "description": "Group React ecosystem updates together",
      "groupName": "react ecosystem",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "/^@types\\/react/",
        "/^react-router/"
      ],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group all npm dev dependencies",
      "groupName": "dev dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "semanticCommitType": "chore",
      "semanticCommitScope": "dev"
    },
    {
      "description": "Group UI component library updates",
      "groupName": "ui stack",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "/^@radix-ui\\//",
        "tailwindcss",
        "@tailwindcss/vite",
        "class-variance-authority",
        "clsx",
        "tailwind-merge",
        "tw-animate-css",
        "lucide-react"
      ],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group Python minor/patch dependencies",
      "groupName": "python dependencies",
      "matchManagers": ["pip_requirements", "pip_setup", "pipenv", "poetry"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "semanticCommitType": "chore",
      "semanticCommitScope": "backend"
    },
    {
      "description": "Group container dependencies",
      "groupName": "container image dependencies",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "docker"
    },
    {
      "description": "Pin Azure Pipelines tasks to major versions only",
      "matchManagers": ["azure-pipelines"],
      "extractVersion": "^(?<version>\\d+)",
      "versioning": "semver",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Manual review for major version bumps",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "breaking"]
    }{% if container_runtime == 'docker' %},
    {
      "description": "Group Docker base image updates",
      "groupName": "docker-images",
      "matchDatasources": ["docker"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "docker"
    }
{% endif %}
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "enabledManagers": [
    "pip_requirements",
    "pip_setup",
    "pep621",
    "npm",
    "dockerfile",
    "docker-compose",
    "azure-pipelines"
  ]
}
