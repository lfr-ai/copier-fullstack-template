{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
{% if use_playwright %}
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--isolated", "--headless"]
    },
{% endif %}
{% if use_storybook %}
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    },
{% endif %}
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "shadcn": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    }{% if with_gitnexus %},
    "gitnexus": {
      "type": "stdio",
      "command": "gitnexus",
      "args": ["mcp"],
      "cwd": "${workspaceFolder}"
    }{% endif %}
  }
}
