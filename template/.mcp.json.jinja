{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "shadcn": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    }{% if with_gitnexus %},
    "gitnexus": {
      "type": "stdio",
      "command": "gitnexus",
      "args": ["mcp"],
      "cwd": "${workspaceFolder}"
    }{% endif %}
  }
}
