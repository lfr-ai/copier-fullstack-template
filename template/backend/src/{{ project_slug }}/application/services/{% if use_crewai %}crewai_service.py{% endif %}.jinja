"""CrewAI application service for multi-agent execution and orchestration.

Provides high-level operations for the CrewAI subsystem:
* Crew template execution (sequential/hierarchical)
* Custom crew assembly and execution
* Flow orchestration through a flow registry
* HMAS goal orchestration through a supervisor port
"""

from __future__ import annotations

from typing import final

import structlog

from {{ project_slug }}.core.interfaces.crewai import (
    CrewFlowRegistry,
    CrewOrchestrationSupervisor,
)
from {{ project_slug }}.core.interfaces.unit_of_work import UnitOfWork

_LOG_TASK_TRUNCATE_LEN = 200


@final
class CrewAIService:
    """Application-layer CrewAI service.

    The service depends on orchestration ports ('CrewOrchestrationSupervisor',
    'CrewFlowRegistry') and keeps concrete CrewAI adapter imports inside method
    boundaries where template crews are assembled.
    """

    def __init__(
        self,
        *,
        uow: UnitOfWork,
        supervisor: CrewOrchestrationSupervisor | None = None,
        flow_registry: CrewFlowRegistry | None = None,
        embedder: dict[str, object] | None = None,
        default_llm: str = "gpt-4o",
        verbose: bool = False,
    ) -> None:
        self._uow = uow
        self._logger: structlog.stdlib.BoundLogger = structlog.get_logger(
            f"{__name__}.{self.__class__.__name__}"
        )
        self._supervisor = supervisor
        self._flow_registry = flow_registry
        self._embedder = embedder
        self._default_llm = default_llm
        self._verbose = verbose

    async def execute_crew(
        self,
        crew_type: str,
        task: str,
        *,
        verbose: bool | None = None,
    ) -> dict[str, object]:
        """Execute a pre-built crew template."""
        from {{ project_slug }}.ai.crewai.templates import (
            create_analysis_crew,
            create_content_crew,
            create_planning_crew,
            create_research_crew,
        )

        factories = {
            "research": create_research_crew,
            "analysis": create_analysis_crew,
            "content": create_content_crew,
            "planning": create_planning_crew,
        }

        factory = factories.get(crew_type)
        if factory is None:
            msg = f"Unknown crew type '{crew_type}'. Available: {sorted(factories)}"
            raise ValueError(msg)

        crew_verbose = verbose if verbose is not None else self._verbose
        crew = factory(
            llm=self._default_llm,
            verbose=crew_verbose,
            embedder=self._embedder,
        )

        self._logger.info(
            "crewai_crew_execute_start",
            crew_type=crew_type,
            task=task[:_LOG_TASK_TRUNCATE_LEN],
        )

        result = crew.kickoff(inputs={"task": task})

        self._logger.info(
            "crewai_crew_execute_complete",
            crew_type=crew_type,
        )

        return {
            "crew_type": crew_type,
            "task": task,
            "result": str(result),
        }

    async def execute_custom_crew(
        self,
        agents_config: list[dict[str, object]],
        tasks_config: list[dict[str, object]],
        *,
        process: str = "sequential",
        verbose: bool | None = None,
    ) -> dict[str, object]:
        """Build and execute a custom crew from config dictionaries."""
        from {{ project_slug }}.ai.crewai.agents import AgentSpec, build_agent
        from {{ project_slug }}.ai.crewai.crews import CrewProcessType, CrewSpec, build_crew
        from {{ project_slug }}.ai.crewai.tasks import TaskSpec, build_task

        crew_verbose = verbose if verbose is not None else self._verbose

        agents = [
            build_agent(
                AgentSpec(
                    role=str(cfg["role"]),
                    goal=str(cfg["goal"]),
                    backstory=str(cfg.get("backstory", "")),
                    llm=str(cfg.get("llm", self._default_llm)),
                    verbose=crew_verbose,
                )
            )
            for cfg in agents_config
        ]

        tasks = [
            build_task(
                TaskSpec(
                    description=str(cfg["description"]),
                    expected_output=str(cfg.get("expected_output", "")),
                    agent=agents[int(cfg.get("agent_index", idx % len(agents)))],
                )
            )
            for idx, cfg in enumerate(tasks_config)
        ]

        spec = CrewSpec(
            agents=agents,
            tasks=tasks,
            process=(
                CrewProcessType.HIERARCHICAL
                if process == "hierarchical"
                else CrewProcessType.SEQUENTIAL
            ),
            verbose=crew_verbose,
            manager_llm=self._default_llm,
        )

        self._logger.info(
            "crewai_custom_crew_start",
            agent_count=len(agents),
            task_count=len(tasks),
            process=process,
        )

        crew = build_crew(spec)
        result = crew.kickoff()

        return {
            "process": process,
            "agent_count": len(agents),
            "task_count": len(tasks),
            "result": str(result),
        }

    async def execute_flow(
        self,
        flow_name: str,
        inputs: dict[str, object] | None = None,
    ) -> dict[str, object]:
        """Execute a registered CrewAI flow."""
        self._logger.info("crewai_flow_start", flow_name=flow_name)

        if self._flow_registry is None:
            msg = "Flow registry not configured for CrewAI service."
            raise RuntimeError(msg)

        result = await self._flow_registry.run(flow_name, inputs=inputs)

        if getattr(result, "error", None) is not None:
            self._logger.error(
                "crewai_flow_failed",
                flow_name=flow_name,
                error=result.error,
            )
            return {"flow_name": flow_name, "error": str(result.error)}

        return {"flow_name": flow_name, "result": getattr(result, "result", result)}

    async def orchestrate(self, goal: str) -> dict[str, object]:
        """Run HMAS hierarchical multi-agent orchestration."""
        if self._supervisor is None:
            msg = "HMAS supervisor not configured for CrewAI service."
            raise RuntimeError(msg)

        self._logger.info("crewai_hmas_orchestrate_start", goal=goal[:_LOG_TASK_TRUNCATE_LEN])
        result = await self._supervisor.orchestrate(goal)
        self._logger.info("crewai_hmas_orchestrate_complete")

        return {"goal": goal, "result": result}

    async def list_crew_templates(self) -> list[dict[str, str]]:
        """List available pre-built crew templates."""
        return [
            {
                "name": "research",
                "description": "Research and analysis crew (researcher + analyst)",
            },
            {
                "name": "analysis",
                "description": "Data analysis crew with hierarchical management",
            },
            {
                "name": "content",
                "description": "Content creation pipeline (writer + editor + QA)",
            },
            {
                "name": "planning",
                "description": "Strategic planning crew with plan validation",
            },
        ]
