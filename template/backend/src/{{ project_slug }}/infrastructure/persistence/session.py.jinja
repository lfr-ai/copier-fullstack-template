"""Database session and engine factory configuration."""

from __future__ import annotations

import structlog
from sqlalchemy.engine import make_url
from sqlalchemy.ext.asyncio import (
    AsyncEngine,
    AsyncSession,
    async_sessionmaker,
    create_async_engine as _create_async_engine,
)
from sqlalchemy.pool import StaticPool

_logger = structlog.get_logger(__name__)


def _is_sqlite_url(*, database_url: str) -> bool:
    """Return True when *database_url* uses the SQLite backend.

    Args:
        database_url (str): Candidate SQLAlchemy database URL.

    Returns:
        bool: True for SQLite URLs.
    """
    return make_url(database_url).get_backend_name() == "sqlite"


def create_engine(database_url: str, *, echo: bool = False) -> AsyncEngine:
    """Create an async SQLAlchemy engine.

    Each environment connects to its own database via DATABASE_URL.
    All tables live in the default ``public`` schema -- no schema routing needed.

    Args:
        database_url (str): Database connection URL.
        echo (bool): Enable SQL statement logging.

    Returns:
        AsyncEngine: Configured async engine instance.
    """
    if _is_sqlite_url(database_url=database_url):
        # SQLite does not support connection pooling in the traditional sense.
        # StaticPool keeps a single connection open for the lifetime of the
        # engine, which is the recommended approach for async SQLite with
        # aiosqlite.
        return _create_async_engine(
            database_url,
            echo=echo,
            connect_args={"check_same_thread": False},
            poolclass=StaticPool,
        )

    engine = _create_async_engine(
        database_url,
        echo=echo,
        pool_pre_ping=True,
    )

    _logger.info(
        "database_engine_created",
        echo=echo,
    )

    return engine


def create_session_factory(engine: AsyncEngine) -> async_sessionmaker[AsyncSession]:
    """Create an async session factory bound to *engine*.

    Args:
        engine (AsyncEngine): Async SQLAlchemy engine.

    Returns:
        async_sessionmaker[AsyncSession]: Configured session factory.
    """
    return async_sessionmaker(
        bind=engine,
        class_=AsyncSession,
        expire_on_commit=False,
    )
