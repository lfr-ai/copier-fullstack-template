"""Shared configuration for all property-based tests.

Automatically applies 'pytest.mark.property' to every test collected
under 'tests/property/'.
"""

from __future__ import annotations

import os

import pytest
from hypothesis import HealthCheck, settings

pytestmark = pytest.mark.property

settings.register_profile(
	"dev",
	max_examples=75,
	deadline=None,
)
settings.register_profile(
	"ci",
	max_examples=200,
	deadline=None,
	suppress_health_check=[HealthCheck.too_slow],
)

settings.load_profile(
	os.environ.get("HYPOTHESIS_PROFILE", "ci" if os.environ.get("CI") else "dev")
)
