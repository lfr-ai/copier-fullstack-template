@pytest_asyncio.fixture(scope="session", loop_scope="session")
async def engine(test_database_url: str) -> AsyncIterator[AsyncEngine]:
    """Create async test database engine.

    Each environment uses its own database. Tests always run against
    ``{{ project_slug }}_test`` using the default ``public`` schema.
    Tables are created at session start and dropped at session end.

    Yields:
        AsyncIterator[AsyncEngine]: Configured async engine with tables created.

    Raises:
        pytest.skip: When no database URL is configured for this template variant.
    """
    from {{ project_slug }}.infrastructure.persistence.orm.base import ORMBase

    resolved_url = test_database_url
    if not resolved_url:
        pytest.skip("No database URL configured for this template variant")

    eng = create_async_engine(resolved_url, echo=False)

    # Create all tables in the test database
    async with eng.begin() as conn:
        await conn.run_sync(ORMBase.metadata.create_all)

    yield eng

    # Drop all tables after test session
    async with eng.begin() as conn:
        await conn.run_sync(ORMBase.metadata.drop_all)
    await eng.dispose()


@pytest_asyncio.fixture
async def session(engine: AsyncEngine) -> AsyncIterator[AsyncSession]:
    """Create async test database session with SAVEPOINT-based rollback.

    Uses a connection-level transaction so the entire test (including any
    work the application does through this session) is rolled back after
    each test.  Inner commits become SAVEPOINTs and are transparently
    restarted, keeping full isolation without DDL churn.

    Args:
        engine (AsyncEngine): Test database engine.

    Yields:
        AsyncSession: Async session rolled back after each test.
    """
    conn = await engine.connect()
    trans = await conn.begin()

    sess = AsyncSession(bind=conn, expire_on_commit=False, join_transaction_block=True)

    yield sess

    await sess.close()
    await trans.rollback()
    await conn.close()


