def _as_bool(value: str | None, *, default: bool) -> bool:
    """Convert common string env values to bool.

    Args:
        value (str | None): Environment variable value.
        default (bool): Fallback when value is missing.

    Returns:
        bool: Parsed boolean.
    """
    if value is None:
        return default
    return value.strip().lower() in {"1", "true", "yes", "on"}


def _resolve_test_db_url() -> str:
    """Resolve the effective test DB URL.

    Returns:
        str: Explicit TEST_DATABASE_URL if provided, otherwise default URL.
    """
    return os.environ.get(_TEST_DB_URL_ENV_VAR_NAME, _DEFAULT_TEST_DB_URL)


def _reset_runtime_singletons() -> None:
    """Clear cached runtime singletons after env mutation.

    Ensures newly set test environment variables are picked up by:
    - settings singleton ('get_settings')
    - container singleton ('get_container')
    """
    from {{ project_slug }}.composition.container import get_container
    from {{ project_slug }}.config.settings import get_settings

    get_settings.cache_clear()
    get_container.cache_clear()


# Set TEST environment for all test runs.
