{%- if database_backend in ('postgresql', 'azure_postgresql') %}
@pytest.fixture(scope="session")
def postgres_container_url(use_testcontainers: bool) -> str | None:
    """Start a PostgreSQL container and return a SQLAlchemy async URL.

    Preference order:
    1. Explicit TEST_DATABASE_URL (external managed DB)
    2. Testcontainers PostgreSQL URL
    3. Static default URL fallback

    Args:
        use_testcontainers (bool): Whether to use Testcontainers.

    Yields:
        str | None: Async SQLAlchemy DB URL or None if not containerized.
    """
    explicit_url = os.environ.get(_TEST_DB_URL_ENV_VAR_NAME)
    if explicit_url:
        yield None
        return

    if not use_testcontainers:
        yield None
        return

    with PostgresContainer(
        image="postgres:16-alpine",
        username="postgres",
        password="postgres",
        dbname="{{ project_slug }}_test",
    ) as postgres:
        sync_url = postgres.get_connection_url(driver=None)
        async_url = sync_url.replace("postgresql://", "postgresql+psycopg://", 1)
        yield async_url


@pytest.fixture(scope="session")
def test_database_url(postgres_container_url: str | None) -> str:
    """Resolve and apply the test database URL for this session.

    Args:
        postgres_container_url (str | None): URL from a running Postgres container.

    Returns:
        str: Effective DB URL used by app + tests.
    """
    resolved = (
        os.environ.get(_TEST_DB_URL_ENV_VAR_NAME)
        or postgres_container_url
        or _resolve_test_db_url()
    )
    if not resolved:
        pytest.skip("No database URL configured for this template variant")

    os.environ[_TEST_DB_URL_ENV_VAR_NAME] = resolved
    os.environ[_APP_DB_URL_VAR_NAME] = resolved
    os.environ[_ENV_VAR_NAME] = "test"
    _reset_runtime_singletons()
    return resolved
{%- else %}


